@{
    ViewData["Title"] = "Admin Login";
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="feedback-card">
    <h1 class="page-title">Admin Login</h1>
    <p class="page-subtitle">Enter the admin access key to manage feedback entries.</p>

    <form asp-action="AdminLogin" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label for="accessKey" class="form-label">Access Key</label>
            <input id="accessKey" name="accessKey" type="password" class="form-control" placeholder="Enter admin key" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-brand">Enable Admin Mode</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}