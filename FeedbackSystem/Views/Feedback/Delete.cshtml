@model FeedbackSystem.Models.FeedbackEntry
@{
    ViewData["Title"] = "Delete Feedback";
}

<div class="feedback-card border-danger">
    <h1 class="page-title text-danger">Delete Feedback</h1>
    <p>Are you sure you want to delete this feedback entry?</p>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Rating</dt>
        <dd class="col-sm-9">@Model.Rating/5</dd>

        <dt class="col-sm-3">Comments</dt>
        <dd class="col-sm-9">@Model.Comments</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Admin" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>