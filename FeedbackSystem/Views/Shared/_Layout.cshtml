<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FeedbackSystem</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FeedbackSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="bg-orb bg-orb-one"></div>
    <div class="bg-orb bg-orb-two"></div>
    <header class="pt-3">
        <div class="container">
            <nav class="navbar navbar-expand-lg brand-nav">
                <div class="container-fluid px-2">
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Feedback" asp-action="Index">Feedback System</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse" id="mainNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav-pills-custom">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Feedback" asp-action="Index">View Feedback</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Feedback" asp-action="Create">Submit Feedback</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Feedback" asp-action="Admin">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Feedback" asp-action="AdminLogin">Admin Login</a>
                            </li>
                        </ul>
                        <form class="d-flex" asp-controller="Feedback" asp-action="AdminLogout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-light px-3">Admin Logout</button>
                        </form>
                    </div>
                </div>
            </nav>
        </div>
    </header>
    <div class="container pb-4 pt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container">
            <div class="footer-box">&copy; 2026 - FeedbackSystem</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
